# SPDX-License-Identifier: Apache-2.0
#
# Configured by CMake (see the `formula-cpp-docs-api` target in
# CMakeLists.txt) into ${CMAKE_CURRENT_BINARY_DIR}/Doxyfile -- the @VAR@
# tokens below are substituted at configure time, so this file itself is never
# handed to Doxygen directly.
#
# The output directory is set by the caller rather than hard-coded here: a
# local build writes it under the build tree, and
# .github/workflows/pages.yml points it at the built MkDocs site's own api/
# subdirectory, so Doxygen and MkDocs never have to know about each other
# beyond that one path.
#
# Most settings below differ from Doxygen's own defaults. A handful do not --
# EXTRACT_ALL, EXTRACT_STATIC, EXTRACT_PRIVATE, HIDE_UNDOC_MEMBERS,
# HIDE_UNDOC_CLASSES, WARN_IF_UNDOCUMENTED, WARN_IF_DOC_ERROR, GENERATE_HTML,
# GENERATE_XML, GENERATE_MAN and GENERATE_RTF are Doxygen's own defaults
# already -- and are stated here anyway, deliberately, so a reader does not
# have to run `doxygen -g` to see that this project actually wants them: the
# undocumented-entity-is-an-error policy and the HTML-only output are both
# load-bearing choices, not accidents of leaving a setting untouched.

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"

OUTPUT_DIRECTORY       = @FORMULA_DOXYGEN_OUTPUT_DIR@

INPUT                  = @PROJECT_SOURCE_DIR@/include
RECURSIVE              = YES
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@/include
FILE_PATTERNS          = *.hpp

# formula::detail is implementation, not API -- the same boundary
# cmake/CheckPublicHeaderIncludes.cmake already draws. This one pattern covers
# both spellings in the tree: a nested `namespace detail { ... }` inside a
# `namespace formula` block, and the flat `namespace formula::detail` used by
# include/formula-cpp/detail/*.hpp -- both produce the fully qualified name
# `formula::detail`.
EXCLUDE_SYMBOLS         = formula::detail formula::detail::*

# The library documents its public surface with `///` comments and expects
# every one of them to have one; an entity Doxygen would otherwise publish
# with no documentation is a build failure, not a warning.
EXTRACT_ALL             = NO
EXTRACT_STATIC          = NO
EXTRACT_PRIVATE         = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = FAIL_ON_WARNINGS

# The first sentence of a `///` block becomes the brief description without
# needing an explicit `@brief` -- matches how every header in include/ is
# already written.
JAVADOC_AUTOBRIEF      = YES

GENERATE_HTML          = YES
# No "html" subdirectory: the caller already points OUTPUT_DIRECTORY at
# exactly where the pages should land.
HTML_OUTPUT            = .
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# Defaults to YES in Doxygen, which makes every call/caller/include graph
# depend on graphviz's `dot`. Nothing in this project's toolchain or CI
# installs it, and on a machine without it Doxygen does not skip the graphs
# quietly -- it exits non-zero with one "Problems running dot" error per
# graph (187 of them, measured against this project's own headers). The site
# needs no call graphs, so the fix is to not need `dot` at all, stated here
# explicitly rather than left to a default a reader would have to already
# know is the wrong one.
HAVE_DOT               = NO

QUIET                  = YES
